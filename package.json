{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Competitor pricing monitor MVP.",
  "main": "src/discover.js",
  "bin": {
    "discover": "src/discover.js"
  },
  "scripts": {
    "discover": "node src/discover.js",
    "lab": "node lab/server.js",
    "service-a": "node src/service-a.js",
    "service-b": "node scripts/run-onboarding-worker.js",
    "service-b:watch": "node scripts/run-onboarding-worker.js --watch",
    "enqueue-daily": "node scripts/enqueue-daily-ticks.js",
    "service-c": "node scripts/run-monitor-worker.js",
    "service-c:watch": "node scripts/run-monitor-worker.js --watch",
    "test": "node test/test-queue.js && node test/test-slack-extractor.js && node test/test-blocked-detection.js && node test/test-wedge.js && node test/test-email-format.js && node test/test-w1-spot-check.js && node test/test-f3-stabilize.js && AUTH_STUB=1 node test/test-f5-auth.js && AUTH_STUB=1 node test/test-f4-intake.js && AUTH_STUB=1 node test/test-f6-b2c.js && node test/test-mail-policy.js",
    "test:queue": "node test/test-queue.js",
    "test:wedge": "node test/test-wedge.js",
    "test:email": "node test/test-email-format.js",
    "test:e2e": "node test/test-service-ab.js",
    "test:e2e:c": "node test/test-service-c.js",
    "test:e2e:mailer": "node test/test-mailer.js",
    "test:offline": "bash scripts/test-7.2-offline.sh",
    "ladder": "node src/plan-ladder-monitor.js",
    "ladder:allowlist": "node src/plan-ladder-monitor.js --allowlist",
    "send-outbox": "node scripts/send-outbox.js",
    "demo": "node scripts/demo-w6-sell.js",
    "demo:fixture": "node scripts/demo-w6-sell.js --fixture",
    "pick": "node scripts/plan-picker-server.js",
    "demo-ui": "node scripts/demo-ui-server.js",
    "migrate:up": "node-pg-migrate up --migration-file-language js --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migration-file-language js --migrations-dir migrations --database-url-var DATABASE_URL",
    "lint": "node --check src/*.js src/steps/*.js scripts/*.js lab/*.js test/*.js",
    "lint:syntax": "node --check src/*.js src/steps/*.js scripts/*.js lab/*.js test/*.js",
    "test:watch-target": "node test/test-watch-target.js",
    "test:f3": "node test/test-f3-stabilize.js",
    "test:f5": "AUTH_STUB=1 node test/test-f5-auth.js",
    "test:f4": "AUTH_STUB=1 node test/test-f4-intake.js",
    "test:f6": "AUTH_STUB=1 node test/test-f6-b2c.js",
    "test:mail-policy": "node test/test-mail-policy.js",
    "migrate:skills": "node scripts/migrate-skills-schema.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DvirBaumel8/pricewatch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DvirBaumel8/pricewatch/issues"
  },
  "homepage": "https://github.com/DvirBaumel8/pricewatch#readme",
  "dependencies": {
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  }
}
