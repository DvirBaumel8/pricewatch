# PriceWatch — environment variables (copy to .env, never commit .env)
#
# Boris: cron-daily-monitor.sh sources this file automatically.
# See docs/cron-pilot.md for full setup.

# ── Neon Postgres ────────────────────────────────────────────────
#
# Required when running in DB mode (migrations, Service A with DB, etc.).
# Obtain from Neon console → Connection Details → Connection string.
# Format: postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# The app fails closed (refuses to start DB features) when DATABASE_URL
# is missing outside explicit lab/file mode.

DATABASE_URL=                    # Neon pooled connection string — NEVER commit
DATABASE_URL_UNPOOLED=           # Optional: direct (non-pooled) connection for migrations
                                 # if the Neon connection pooler breaks DDL.
                                 # node-pg-migrate uses DATABASE_URL by default;
                                 # set this and pass --database-url-var DATABASE_URL_UNPOOLED
                                 # to migrate commands if pooled connection causes issues.

DATABASE_URL_NODE=              # Optional: Mark/Node-side Neon URL alias.
                                 # Prefer DATABASE_URL for the app (src/db.js).
                                 # Migrations: DATABASE_URL_UNPOOLED if set, else
                                 # DATABASE_URL_NODE if set, else DATABASE_URL.

# Fail closed: require DATABASE_URL when set to 1 (also forced if NODE_ENV=production).
# PRICEWATCH_REQUIRE_DB=1

# ── Mail transport ───────────────────────────────────────────────
#
# send-outbox.js supports SMTP and Resend. When neither credential is set
# (exit 7), use the gmail-mcp agent path instead — see docs/pilot-onboarding.md §5b.
#
# Priority: SMTP (if PASS set) → Resend (if KEY set) → gmail-mcp (agent).
# Force one transport: PRICEWATCH_MAIL_TRANSPORT=smtp  # or "resend"

# ── Option A: Resend (preferred for §8.1 — free tier) ───────────

RESEND_API_KEY=                  # Resend API key — NEVER commit

# Resend cannot send as a Gmail address unless the domain is verified.
# Use the Resend sandbox sender, or a verified custom domain:
PRICEWATCH_MAIL_FROM=PriceWatch <onboarding@resend.dev>
PRICEWATCH_MAIL_REPLY_TO=price.watcher.service@gmail.com
# Boris alias: PRICEWATCH_REPLY_TO also accepted

# ── Option B: Gmail SMTP (fallback when SMTP_PASS available) ────

PRICEWATCH_SMTP_HOST=smtp.gmail.com
PRICEWATCH_SMTP_PORT=587
PRICEWATCH_SMTP_USER=price.watcher.service@gmail.com
PRICEWATCH_SMTP_PASS=            # Gmail app password — NEVER commit
# Port 587 uses STARTTLS (default). For implicit TLS on 465:
#   PRICEWATCH_SMTP_PORT=465
#   PRICEWATCH_SMTP_SECURE=1
# When using SMTP, MAIL_FROM defaults to SMTP_USER if unset.

# ── Ops alerts ───────────────────────────────────────────────────

# ops_alert emails go here (defaults to MAIL_FROM if unset)
# PRICEWATCH_OPS_EMAIL=price.watcher.service@gmail.com

# ── Test address (§8.1) ──────────────────────────────────────────

PRICEWATCH_TEST_EMAIL=dvirbaumel9@gmail.com

# ── Mail allowlist (M1b gate) ────────────────────────────────────
#
# Until M1b unlock, send-outbox.js only sends to recipients on this
# allowlist. Non-allowlisted recipients are skipped (logged, outbox
# preserved for audit, non-fatal).
#
# PRICEWATCH_TEST_EMAIL and PRICEWATCH_OPS_EMAIL are auto-included.
# Additional addresses: comma-separated.

# PRICEWATCH_MAIL_ALLOWLIST=team@example.com,founder@example.com

# Set to 1 to unlock sending to ANY recipient (M1b milestone reached).
# Default unset/empty = locked (allowlist enforced).
# PRICEWATCH_M1B_UNLOCK=1

# ── Kill switch ──────────────────────────────────────────────────

# PRICEWATCH_KILL=1              # stops enqueue + Service C + send-outbox (mailer)

# ── GitHub Actions daily cron ────────────────────────────────────
#
# PRICEWATCH_CRON_ARMED — GitHub Actions variable (NOT a secret).
# Set to "1" in GitHub → repo Settings → Secrets and variables → Actions →
# Variables to enable the daily-cron workflow. When unset or not "1",
# the scheduled job logs "disarmed — skip" and exits cleanly.
# See docs/cron-pilot.md for full arming instructions.
#
# This variable lives in GitHub Actions — it is NOT needed in .env or Render.

# ── Render deploy ────────────────────────────────────────────────
#
# On Render, SERVICE_A_HOST must be 0.0.0.0 (scripts/render-start.sh sets
# this automatically). Render injects PORT; the start script maps it to
# SERVICE_A_PORT.
#
# SERVICE_A_HOST=0.0.0.0         # Render requires binding to all interfaces
# SERVICE_A_PORT=                 # Mapped from Render's PORT by render-start.sh
#
# See docs/render-ops.md for full Render environment setup.
