# PriceWatch — environment variables (copy to .env, never commit .env)
#
# Boris: cron-daily-monitor.sh sources this file automatically.
# See docs/cron-pilot.md for full setup.
#
# Carlos-locked SMTP defaults — do not change unless Carlos says so.

# ── Mail transport (pick one) ────────────────────────────────────

# Option A: Gmail SMTP (preferred — $0, app password required)
PRICEWATCH_SMTP_HOST=smtp.gmail.com
PRICEWATCH_SMTP_PORT=587
PRICEWATCH_SMTP_USER=price.watcher.service@gmail.com
PRICEWATCH_SMTP_PASS=            # Gmail app password — NEVER commit
# Port 587 uses STARTTLS (default). For implicit TLS on 465:
#   PRICEWATCH_SMTP_PORT=465
#   PRICEWATCH_SMTP_SECURE=1

# Option B: Resend (if CEO provides key via secret-request)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Sender / Reply-To ───────────────────────────────────────────

PRICEWATCH_MAIL_FROM=price.watcher.service@gmail.com
# PRICEWATCH_MAIL_REPLY_TO=price.watcher.service@gmail.com
# Boris alias: PRICEWATCH_REPLY_TO also accepted
# Defaults: MAIL_FROM defaults to SMTP_USER; REPLY_TO defaults to MAIL_FROM

# ── Ops alerts ───────────────────────────────────────────────────

# ops_alert emails go here (defaults to MAIL_FROM if unset)
# PRICEWATCH_OPS_EMAIL=price.watcher.service@gmail.com

# ── Kill switch ──────────────────────────────────────────────────

# PRICEWATCH_KILL=1              # stops enqueue + Service C + mailer
